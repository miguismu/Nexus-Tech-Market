{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NEXUS: iniciar API local",
      "type": "process",
      "command": "py",
      "args": [
        "-X",
        "utf8",
        "${workspaceFolder}\\iniciar_nexus.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "NEXUS: iniciar sitio HTTPS local",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\iniciar-nexus-https.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DOTNET_CLI_HOME": "${workspaceFolder}\\.dotnet-cli"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Compilando.*",
          "endsPattern": ".*Now listening on: https://localhost:5500.*"
        }
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "NEXUS: abrir sitio seguro en Chrome",
      "dependsOn": [
        "NEXUS: iniciar API local",
        "NEXUS: iniciar sitio HTTPS local"
      ],
      "dependsOrder": "sequence",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\abrir-nexus-chrome.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      }
    }
  ]
}
