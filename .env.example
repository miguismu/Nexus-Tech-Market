# Copia este archivo a .env y define secretos propios antes de publicar.
# El proyecto no carga .env automáticamente: configura las variables en la terminal.
NEXUS_SESSION_SECRET=
NEXUS_ADMIN_CODE=
# Nombre completo del administrador del panel de revisión.
NEXUS_ADMIN_NAME=Miguel Alejandro Muñoz Suárez
# Déjalo sin definir para usar nexus.db (SQLite).
# Ejemplo PostgreSQL: postgresql+psycopg://usuario:clave@localhost:5432/nexus
DATABASE_URL=
# Usa true solo si el backend se sirve realmente detrás de HTTPS.
NEXUS_HTTPS=false
